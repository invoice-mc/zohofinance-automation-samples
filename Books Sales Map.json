  "_deluge_referencia": {
    "_nota": "Ejemplos de acceso a campos en Deluge",
    "obtener_registro": "registro = zoho.books.getRecordsByID('Invoices', organizationID, invoiceID, 'zbooks').get('invoice');",
    "campo_simple": "total = registro.get('total');",
    "campo_personalizado": "valorCF = registro.get('custom_field_hash').get('cf_nombre_api_campo');",
    "lineas_item": "lineItems = registro.get('line_items').toList();",
    "recorrer_items": "for each item in lineItems { nombre = item.get('name'); cantidad = item.get('quantity'); }",
    "nombres_modulo_validos": "Invoices | Estimates | Salesorders | Purchaseorders | Bills | Creditnotes | Contacts | Items | CustomerPayments | Expenses | RetainerInvoices | RecurringInvoices | SalesReceipts"
  }
