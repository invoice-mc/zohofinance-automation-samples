    "_nota": "Referencia rápida de funciones Deluge para acceder a módulos de Zoho Books",
    "modulos_validos": "Invoices | Estimates | Salesorders | Purchaseorders | Bills | Creditnotes | VendorCredits | Contacts | Items | CustomerPayments | VendorPayments | Expenses | RetainerInvoices | RecurringInvoices | SalesReceipts",
    "obtener_registro": "registro = zoho.books.getRecordsByID('NombreModulo', organizationID, recordID, 'zbooks').get('nombre_clave');",
    "ejemplos_obtener": {
      "invoice": "zoho.books.getRecordsByID('Invoices', organizationID, invoiceID, 'zbooks').get('invoice')",
      "salesorder": "zoho.books.getRecordsByID('Salesorders', organizationID, soID, 'zbooks').get('salesorder')",
      "estimate": "zoho.books.getRecordsByID('Estimates', organizationID, estimateID, 'zbooks').get('estimate')",
      "purchaseorder": "zoho.books.getRecordsByID('Purchaseorders', organizationID, poID, 'zbooks').get('purchaseorder')",
      "bill": "zoho.books.getRecordsByID('Bills', organizationID, billID, 'zbooks').get('bill')",
      "contact": "zoho.books.getRecordsByID('Contacts', organizationID, contactID, 'zbooks').get('contact')",
      "item": "zoho.books.getRecordsByID('Items', organizationID, itemID, 'zbooks').get('item')",
      "expense": "zoho.books.getRecordsByID('Expenses', organizationID, expenseID, 'zbooks').get('expense')"
    },
    "campo_simple": "valor = registro.get('nombre_campo');",
    "campo_personalizado": "valorCF = registro.get('custom_field_hash').get('cf_api_name_del_campo');",
    "actualizar_campo_personalizado": "zoho.books.updateRecord('Invoices', organizationID, invoiceID, {'custom_fields': [{'api_name': 'cf_nombre_campo', 'value': nuevoValor}]}, 'zbooks');",
    "lineas_item": "lineItems = registro.get('line_items').toList();",
    "recorrer_items": "for each item in lineItems { nombre = item.get('name'); cantidad = item.get('quantity'); precio = item.get('rate'); total = item.get('item_total'); }",
    "crear_registro": "zoho.books.createRecord('NombreModulo', organizationID, mapaData, 'zbooks');",
    "actualizar_registro": "zoho.books.updateRecord('NombreModulo', organizationID, recordID, mapaData, 'zbooks');"
  }
